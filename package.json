{
  "name": "mapwar",
  "version": "1.0.0",
  "description": "MAPWAR — 历史大乱斗。在真实历史地理地图上，百余势力（历史上的政权、民族、大家族）各据一城，展开跨越时空的沙盘战争。",
  "main": "game.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node tools/rename_duplicate_idle_portraits.mjs && concurrently \"vite\" \"node auto_backup.cjs\" \"cd tools/PortraitMatting && py app.py\"",
    "build": "vite build",
    "preview": "vite preview",
    "assets:case-check": "node scratch/audit_assets_case.mjs",
    "tier:export": "npx tsx scratch/assign_flag_template_by_tier.ts",
    "tier:check": "npx tsx scratch/check_tier_audit_conflicts.mjs",
    "flag-text:check": "npx tsx scratch/audit_flag_text_luminance.mjs",
    "zoom:rules-test": "npx tsx scratch/test_zoom_controller_naval.mts",
    "scene13:water-audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_scene13_water_color.mts",
    "phalanx:row-audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_phalanx_row_spacing.mts",
    "naval:ship-audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_culture_naval_ships.mts",
    "naval:sprite-audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_ship_sprites.mts",
    "road:snap-audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_road_snap_pruning.mts",
    "naval:leg-audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_march_sea_legs.mts",
    "naval:step-audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_naval_step_spacing.mts",
    "expedition:audit": "npx tsx scratch/audit_expedition_regions.mjs",
    "expedition:triple-check": "npx tsx scratch/audit_expedition_triple_names.mjs",
    "expedition:coverage": "npx tsx scratch/audit_expedition_coverage.mjs",
    "skeleton:audit": "npx tsx scratch/audit_skeleton_anchors.mjs",
    "city:spacing": "npx tsx scratch/audit_city_spacing.mjs",
    "world:audit": "npx tsx --import ./tools/sim-preload.mjs scratch/audit_world_readiness.mts",
    "world:coords": "npx tsx --import ./tools/sim-preload.mjs scratch/verify_global_coordinates.mts",
    "portrait:adjust-cleanup": "node scratch/cleanup_portrait_adjust.mjs",
    "portrait:build-canonical": "node scratch/build_portrait_canonical.mjs",
    "portrait:idle-rename": "node tools/rename_idle_portraits.mjs",
    "portrait:idle-preview": "node tools/rename_idle_portraits.mjs --dry-run",
    "portrait:dup-rename": "node tools/rename_duplicate_idle_portraits.mjs",
    "portrait:dup-preview": "node tools/rename_duplicate_idle_portraits.mjs --dry-run",
    "portrait:surplus-audit": "node tools/audit_surplus_deletable.mjs",
    "culture:audit": "node tools/culture_audit.mjs",
    "bgm:audit": "node tools/bgm_audit.mjs",
    "portrait:folder-audit": "node scratch/dedupe_portraits_within_folder.mjs --audit",
    "portrait:folder-dedupe": "node scratch/dedupe_portraits_within_folder.mjs",
    "portrait:culture-folders": "node scratch/audit_region_portrait_folders.mjs",
    "city:dossier": "npx tsx scratch/export_city_dossier.mjs",
    "city:lookup": "npx tsx scratch/export_city_dossier.mjs --",
    "add:check": "npx tsx scratch/audit_add_completeness.mjs --",
    "faction:sync-audit": "npx tsx scratch/audit_faction_capital_sync.mjs",
    "tier:pending": "node scratch/export_faction_tier_pending.mjs",
    "audit": "node scripts/audit-game-integrity.mjs",
    "guard": "node scripts/guard.mjs",
    "guard:full": "node scripts/guard.mjs --full",
    "sim": "tsx --import ./tools/sim-preload.mjs scripts/sim/headless.ts",
    "sim:roster": "tsx --import ./tools/sim-preload.mjs tools/simulator-roster.ts",
    "sim:expedition": "tsx --import ./tools/sim-preload.mjs tools/expedition-sim.ts",
    "sim:yuefei": "tsx --import ./tools/sim-preload.mjs tools/yuefei-huanglong-sim.ts",
    "sim:skill": "tsx tools/skill-balance-sim.ts",
    "sim:legion": "tsx --import ./tools/sim-preload.mjs tools/legion-sim.ts",
    "sim:campaign": "tsx --import ./tools/sim-preload.mjs tools/legion-campaign.ts",
    "sim:balance-audit": "tsx --import ./tools/sim-preload.mjs tools/balance-cohort-audit.ts",
    "sim:diagnose-t0": "tsx --import ./tools/sim-preload.mjs tools/balance-diagnose-t0.ts",
    "sim:follow": "tsx tools/follow-legion-test.ts",
    "tactical:audit": "tsx tools/tactical-skill-audit.ts",
    "tactical:weights": "tsx tools/tactical-condition-weights.ts",
    "tactical:fate-mc": "tsx tools/tactical-fate-mc.ts",
    "tactical:casualty-mc": "tsx tools/tactical-casualty-mc.ts",
    "tactical:counter-mc": "tsx tools/tactical-counter-mc.ts",
    "tactical:balance": "tsx tools/tactical-balance-mc.ts",
    "tactical:assign-audit": "tsx tools/tactical-assign-audit.ts",
    "tactical:triclass": "tsx tools/tactical-triclass-audit.ts",
    "general:ecology-audit": "tsx tools/general-profile-ecology-audit.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "era:audit": "node scripts/audit_general_centuries.cjs",
    "era:todo": "node scripts/audit_general_centuries.cjs --todo"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.3",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pinyin-pro": "^3.28.0",
    "puppeteer-core": "^25.7.0"
  }
}
