{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "alwaysLoad": true
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
