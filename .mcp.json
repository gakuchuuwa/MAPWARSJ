        "--isolated",
        "--memoryDebugging",
        "--experimentalVision",
        "--workspace", "C:\\MAPWARSJ",
        "--viewport", "1920x1080",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
